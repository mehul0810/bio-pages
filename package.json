{
  "name": "bio-pages",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-profile.mjs",
    "build": "npm run validate && vite build && node scripts/build-meta.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run test && npm run test:ui && npm run build",
    "test:ui": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:spacefast": "npm run check && node scripts/prepare-spacefast.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "vite": "^6.4.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
